+#include "qcom_dsp.h"
+#include <stdio.h>
+#include <stdlib.h>
+#include <stdbool.h>
+#include <unistd.h>
+#include <getopt.h>
+
+static void print_usage(const char *progname)
+{
+    fprintf(stderr,
+            "Usage: %s [OPTIONS]\n\n"
+            "Options:\n"
+            "  -c, --count <N>       Number of samples to collect before exit (default: 1, 0 = infinite)\n"
+            "  -i, --interval <sec>  Sample interval in seconds (default: 1)\n"
+            "  -j, --json            Output newline-delimited JSON (default: text)\n"
+            "  -h, --help            Show this help message\n",
+            progname);
+}
+
+int main(int argc, char *argv[])
+{
+    int count = 1;
+    int interval_sec = 1;
+    bool json_output = false;
+
+    static struct option long_options[] = {
+        {"count",    required_argument, 0, 'c'},
+        {"interval", required_argument, 0, 'i'},
+        {"json",     no_argument,       0, 'j'},
+        {"help",     no_argument,       0, 'h'},
+        {0, 0, 0, 0}
+    };
+
+    int opt;
+    while ((opt = getopt_long(argc, argv, "c:i:jh", long_options, NULL)) != -1) {
+        switch (opt) {
+        case 'c':
+            count = atoi(optarg);
+            if (count < 0)
+                count = 0;
+            break;
+        case 'i':
+            interval_sec = atoi(optarg);
+            if (interval_sec < 1)
+                interval_sec = 1;
+            break;
+        case 'j':
+            json_output = true;
+            break;
+        case 'h':
+            print_usage(argv[0]);
+            return EXIT_SUCCESS;
+        default:
+            print_usage(argv[0]);
+            return EXIT_FAILURE;
+        }
+    }
+
+    struct qcom_dsp_ctx *ctx = qcom_dsp_open(DSP_NPU0);
+    if (!ctx) {
+        fprintf(stderr, "Error: qcom_dsp_open(DSP_NPU0) failed\n");
+        return EXIT_FAILURE;
+    }
+
+    unsigned int arch = qcom_dsp_prof_get_q6_arch_version(ctx);
+    int no_metrics = 0;
+    int iter = 0;
+
+    while (count == 0 || iter < count) {
+        struct sysmon_query_prof_data *data = qcom_dsp_get_prof_data(ctx, &no_metrics);
+        if (!data || no_metrics <= 0) {
+            fprintf(stderr, "Error: qcom_dsp_get_prof_data failed\n");
+            qcom_dsp_close(ctx);
+            return EXIT_FAILURE;
+        }
+
+        float hmx = qcom_dsp_prof_get_hmx_utilization(data);
+        float hvx = qcom_dsp_prof_get_hvx_utilization(data);
+        float q6 = qcom_dsp_prof_get_q6_utilization(data);
+        unsigned int clk = qcom_dsp_prof_get_q6_clock(data);
+
+        if (json_output) {
+            printf("{\"arch\":%u,\"clk_khz\":%u,\"q6_util\":%.2f,\"hvx_util\":%.2f,\"hmx_util\":%.2f}\n",
+                   arch, clk, q6, hvx, hmx);
+        } else {
+            printf("NPU0 [v%u] | Clock: %u kHz | Q6: %.2f%% | HVX: %.2f%% | HMX: %.2f%%\n",
+                   arch, clk, q6, hvx, hmx);
+        }
+        fflush(stdout);
+
+        iter++;
+        if (count == 0 || iter < count) {
+            sleep((unsigned int)interval_sec);
+        }
+    }
+
+    qcom_dsp_close(ctx);
+    return EXIT_SUCCESS;
+}
