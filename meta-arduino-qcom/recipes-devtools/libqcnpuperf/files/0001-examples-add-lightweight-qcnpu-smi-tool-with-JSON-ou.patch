From 9b9c864e09ee7765f3d5e94a17503a59d24c4100 Mon Sep 17 00:00:00 2001
From: Massimo Pennazio <maxipenna@libero.it>
Date: Mon, 26 Oct 2026 13:24:49 +0100
Subject: [PATCH] examples: add lightweight qcnpu-smi tool with JSON output

---
 CMakeLists.txt       |  19 +++++++
 examples/qcnpu_smi.c | 128 +++++++++++++++++++++++++++++++++++++++++++
 2 files changed, 147 insertions(+)
 create mode 100644 examples/qcnpu_smi.c

diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0a38aaf..e1e84c0 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -10,6 +10,7 @@ project(qcnpuperf
 # Options / paths
 # ------------------------------------------------------------
 option(QCNPU_PERF_BUILD_CLI "Build ncurses-based CLI sample (qcnpuperf_cli)" ON)
+option(QCNPU_PERF_BUILD_SMI "Build lightweight CLI tool (qcnpu-smi)" ON)
 
 # Allow overriding FastRPC paths at configure time
 find_path(FASTRPC_INCLUDE_DIR AEEStdDef.h
@@ -118,6 +119,24 @@ if(QCNPU_PERF_BUILD_CLI)
   endif()
 endif()
 
+# ------------------------------------------------------------
+# Lightweight CLI tool (qcnpu-smi)
+# ------------------------------------------------------------
+if(QCNPU_PERF_BUILD_SMI)
+  add_executable(qcnpu-smi examples/qcnpu_smi.c)
+
+  target_include_directories(qcnpu-smi PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/inc
+    ${FASTRPC_INCLUDE_DIR}
+  )
+
+  target_link_libraries(qcnpu-smi PRIVATE
+    qcnpuperf
+  )
+
+  install(TARGETS qcnpu-smi RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR})
+endif()
+
 # ------------------------------------------------------------
 # Install rules
 # ------------------------------------------------------------
diff --git a/examples/qcnpu_smi.c b/examples/qcnpu_smi.c
new file mode 100644
index 0000000..3333ee0
--- /dev/null
+++ b/examples/qcnpu_smi.c
@@ -0,0 +1,128 @@
